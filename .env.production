# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# IMPORTANT: This file contains production settings
# Copy this to .env on your production server and fill in the values
# ============================================================================

# ============================================================================
# FLASK CONFIGURATION
# ============================================================================
FLASK_ENV=production
FLASK_DEBUG=False
# CRITICAL: Generate a secure secret key with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-KEY
HOST=0.0.0.0
PORT=5000

# ============================================================================
# SMTP CONFIGURATION
# ============================================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=aureumreputations@gmail.com
MAIL_PASSWORD=your-production-app-password-here
MAIL_DEFAULT_SENDER=aureumreputations@gmail.com
RECIPIENT_EMAIL=aureumreputations@gmail.com

# ============================================================================
# PRODUCTION NOTES
# ============================================================================
# 1. Never commit this file to Git
# 2. Use environment variables on your hosting platform instead
# 3. For Gmail, use App Passwords: https://myaccount.google.com/apppasswords
# 4. Consider using dedicated email services (SendGrid, Mailgun, AWS SES)
# 5. Enable HTTPS on your production server
# 6. Use a production WSGI server (gunicorn, uWSGI)
# ============================================================================

